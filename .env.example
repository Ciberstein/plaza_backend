NODE_ENV=development
PORT=4000

# Comma separated. Credentials travel in a cookie, which forbids a wildcard
# origin, so the list has to be explicit.
CORS_ORIGINS=http://localhost:5173

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=plaza
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET_SEED=
JWT_EXPIRES_IN=7d
