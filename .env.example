NODE_ENV=development
PORT=4000

# Comma separated. Credentials travel in a cookie, which forbids a wildcard
# origin, so the list has to be explicit.
CORS_ORIGINS=http://localhost:5173

# How many proxies sit in front of this process. Rate limiting is by address,
# and behind a load balancer every request arrives from the balancer — with
# this at 0 the whole internet shares one bucket and ten failed logins by
# anybody lock out everybody.
#
# 0 for local, where nothing is in front. 1 behind a single balancer, which is
# what Render, Railway, Fly and Heroku each give you. Never a blanket "trust
# everything": X-Forwarded-For is written by the caller, so trusting all of it
# lets anyone hand themselves a fresh address per request and never meet a
# limit at all.
TRUST_PROXY=0

DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=plaza
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET_SEED=
JWT_EXPIRES_IN=7d

# How long a verification or reset code stays valid, in minutes.
AUTH_CODE_TTL_MINUTES=15

# Transactional email. Without RESEND_API_KEY nothing is sent and every send
# reports false — the server still boots.
RESEND_API_KEY=
MAIL_SEND_ADDR=
MAIL_FROM_NAME=Plaza
# Where replies land. The sending address has no mailbox behind it.
MAIL_REPLY_TO=

# Image uploads. Without these, upload endpoints answer 503 rather than 500.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Root folder every upload is filed under. One Cloudinary account usually
# serves every environment, so give each one its own root and a photo uploaded
# while testing never lands beside a real one. Defaults to plaza.
CLOUDINARY_FOLDER=plaza
